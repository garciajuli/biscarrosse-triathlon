---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { dateLongue, iso } from '../../lib/content';

export async function getStaticPaths() {
  const articles = await getCollection('actualites', ({ data }) => !data.brouillon);
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

type Props = { article: CollectionEntry<'actualites'> };

const { article } = Astro.props;
const { Content } = await render(article);
---

<BaseLayout
  titre={`${article.data.titre} — Biscarrosse Olympique Triathlon`}
  description={article.data.resume}
  image={article.data.image}
  type="article"
>
  <article class="pb-20 sm:pb-24">
    <!-- bandeau titre : le nav flotte par-dessus, d'où -mt-18/pt-18 -->
    <header class="-mt-18 bg-deep pt-18 text-white">
      <div class="shell max-w-3xl py-16 sm:py-20">
        <a
          href="/#actualites"
          class="inline-flex items-center gap-2 font-display text-sm font-semibold tracking-wider text-ocean-300 uppercase transition-colors hover:text-white"
        >
          <svg
            viewBox="0 0 16 16"
            class="h-3.5 w-3.5"
            aria-hidden="true"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M13.5 8h-10M7 4.5 3.5 8 7 11.5" />
          </svg>
          Toutes les actualités
        </a>

        <div class="mt-6 flex flex-wrap items-center gap-3">
          <span class="rounded-full bg-ocean-400 px-3 py-1 font-display text-xs font-semibold tracking-wider text-navy-900 uppercase">
            {article.data.categorie}
          </span>
          <time class="text-sm font-medium text-navy-200" datetime={iso(article.data.date)}>
            {dateLongue(article.data.date)}
          </time>
        </div>

        <h1 class="mt-4 text-4xl leading-[1.05] text-white sm:text-5xl">{article.data.titre}</h1>
        <p class="mt-5 text-lg leading-relaxed text-navy-100">{article.data.resume}</p>
      </div>
    </header>

    {
      article.data.image && (
        <div class="shell max-w-4xl">
          <img
            src={article.data.image}
            alt={article.data.image_alt ?? ''}
            width="1600"
            height="900"
            loading="eager"
            decoding="async"
            class="-mt-10 aspect-[16/9] w-full rounded-card object-cover shadow-lift sm:-mt-14"
          />
        </div>
      )
    }

    <div class="shell prose-club mt-12 max-w-3xl">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  /* Mise en forme du Markdown rédigé dans le CMS (sans plugin typographique) */
  .prose-club {
    font-size: 1.075rem;
    line-height: 1.75;
    color: var(--color-navy-600);
  }
  .prose-club :global(h2) {
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
    font-size: 1.65rem;
  }
  .prose-club :global(h3) {
    margin-top: 2rem;
    margin-bottom: 0.5rem;
    font-size: 1.3rem;
  }
  .prose-club :global(p) {
    margin-block: 1.15rem;
  }
  .prose-club :global(strong) {
    color: var(--color-navy-900);
    font-weight: 600;
  }
  .prose-club :global(a) {
    color: var(--color-ocean-600);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }
  .prose-club :global(ul),
  .prose-club :global(ol) {
    margin-block: 1.15rem;
    padding-left: 1.35rem;
  }
  .prose-club :global(ul) {
    list-style: disc;
  }
  .prose-club :global(ol) {
    list-style: decimal;
  }
  .prose-club :global(li) {
    margin-block: 0.4rem;
  }
  .prose-club :global(li)::marker {
    color: var(--color-ocean-500);
  }
  .prose-club :global(blockquote) {
    margin-block: 1.75rem;
    border-left: 3px solid var(--color-ocean-400);
    padding-left: 1.25rem;
    font-style: italic;
    color: var(--color-navy-500);
  }
  .prose-club :global(table) {
    width: 100%;
    margin-block: 1.75rem;
    border-collapse: collapse;
    font-size: 0.975rem;
  }
  .prose-club :global(th) {
    border-bottom: 2px solid var(--color-navy-100);
    padding: 0.6rem 0.75rem;
    text-align: left;
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--color-navy-900);
  }
  .prose-club :global(td) {
    border-bottom: 1px solid var(--color-navy-50);
    padding: 0.6rem 0.75rem;
  }
  .prose-club :global(img) {
    margin-block: 2rem;
    border-radius: var(--radius-card);
  }
  .prose-club :global(hr) {
    margin-block: 2.5rem;
    border: 0;
    border-top: 1px solid var(--color-navy-100);
  }
</style>
