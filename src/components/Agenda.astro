---
import { getCollection } from 'astro:content';
import SectionHeader from './ui/SectionHeader.astro';
import DisciplineIcon from './ui/DisciplineIcon.astro';
import { home, jour, mois, annee, periode, iso, aujourdhui } from '../lib/content';

const limite = aujourdhui();

const evenements = (await getCollection('agenda', ({ data }) => !data.brouillon))
  // un événement reste affiché jusqu'à sa date de fin (ou sa date)
  .filter((e) => (e.data.date_fin ?? e.data.date) >= limite)
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime())
  .slice(0, 5);

const { agenda } = home;

const badges: Record<string, string> = {
  Compétition: 'bg-ocean-400 text-navy-900',
  Club: 'bg-white/15 text-white',
  Stage: 'bg-sand-300 text-navy-900',
  Bénévoles: 'bg-white text-navy-800',
};
---

<section id="agenda" class="relative scroll-mt-24 overflow-hidden bg-deep py-20 text-white sm:py-24 lg:py-28">
  <div
    class="pointer-events-none absolute -top-32 -right-32 h-[28rem] w-[28rem] rounded-full bg-ocean-500/20 blur-3xl"
    aria-hidden="true"
  >
  </div>

  <div class="shell relative">
    <SectionHeader eyebrow={agenda.eyebrow} titre={agenda.titre} intro={agenda.intro} sombre class="reveal" />

    {
      evenements.length === 0 ? (
        <p class="mt-12 text-lg text-navy-200">Le calendrier de la prochaine saison arrive très vite.</p>
      ) : (
        <ol class="mt-14 divide-y divide-white/12 border-t border-white/12">
          {evenements.map((e, i) => (
            <li class="reveal" style={`transition-delay:${i * 70}ms`}>
              <div class="flex flex-col gap-5 py-7 sm:flex-row sm:items-center sm:gap-8">
                <time
                  datetime={iso(e.data.date)}
                  class="flex w-20 shrink-0 flex-col items-center rounded-2xl bg-white/8 py-3 ring-1 ring-white/12"
                >
                  <span class="font-display text-3xl leading-none font-semibold tabular-nums text-white">
                    {jour(e.data.date)}
                  </span>
                  <span class="mt-1 font-display text-sm font-medium tracking-widest text-ocean-300 uppercase">
                    {mois(e.data.date)}
                  </span>
                  <span class="text-[0.7rem] font-medium text-navy-300">{annee(e.data.date)}</span>
                </time>

                <div class="min-w-0 flex-1">
                  <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
                    <span
                      class={`rounded-full px-3 py-1 font-display text-xs font-semibold tracking-wider uppercase ${badges[e.data.type] ?? 'bg-white/15 text-white'}`}
                    >
                      {e.data.type}
                    </span>
                    {e.data.disciplines.length > 0 && (
                      <span class="flex items-center gap-1.5 text-ocean-300" aria-hidden="true">
                        {e.data.disciplines.map((d) => (
                          <DisciplineIcon discipline={d} class="h-4 w-4" />
                        ))}
                      </span>
                    )}
                    <span class="text-sm text-navy-200">{periode(e.data.date, e.data.date_fin)}</span>
                  </div>

                  <h3 class="mt-2.5 text-xl text-white lg:text-2xl">{e.data.titre}</h3>

                  <p class="mt-1.5 flex flex-wrap items-center gap-x-2.5 gap-y-1 text-sm text-navy-200">
                    <span class="inline-flex items-center gap-1.5">
                      <svg
                        viewBox="0 0 16 16"
                        class="h-3.5 w-3.5 text-ocean-300"
                        aria-hidden="true"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.6"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <path d="M8 14.5s5-4.2 5-8A5 5 0 0 0 3 6.5c0 3.8 5 8 5 8Z" />
                        <circle cx="8" cy="6.4" r="1.8" />
                      </svg>
                      {e.data.lieu}
                    </span>
                    {e.data.format && (
                      <>
                        <span class="text-white/25" aria-hidden="true">·</span>
                        <span>{e.data.format}</span>
                      </>
                    )}
                  </p>

                  {e.data.resume && <p class="mt-3 max-w-2xl leading-relaxed text-navy-100">{e.data.resume}</p>}
                </div>

                {e.data.lien_inscription && (
                  <a
                    href={e.data.lien_inscription}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="shrink-0 self-start rounded-full border border-white/35 px-5 py-2.5 font-display text-sm font-semibold tracking-wider uppercase transition hover:border-white hover:bg-white/10 sm:self-center"
                  >
                    S'inscrire
                  </a>
                )}
              </div>
            </li>
          ))}
        </ol>
      )
    }
  </div>
</section>
