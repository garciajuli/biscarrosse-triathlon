---
import Logo from './ui/Logo.astro';
import SocialIcon from './ui/SocialIcon.astro';
import { site, withBase } from '../lib/content';

const annee = new Date().getFullYear();
---

<footer class="bg-navy-950 text-navy-200">
  <div class="shell py-14 lg:py-16">
    <div class="grid gap-12 lg:grid-cols-[1.2fr_1fr_1fr]">
      <div>
        <a href={withBase('/')} class="inline-block text-white transition-opacity hover:opacity-80">
          <Logo />
        </a>
        <p class="mt-5 max-w-sm leading-relaxed">{site.baseline}</p>
        <p class="mt-2 text-sm text-navy-300">{site.affiliation}</p>

        <ul class="mt-6 flex gap-2.5">
          {
            site.reseaux.map((r) => (
              <li>
                <a
                  href={r.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex h-10 w-10 items-center justify-center rounded-full bg-white/8 text-white transition hover:bg-ocean-400 hover:text-navy-900"
                  aria-label={r.nom}
                >
                  <SocialIcon nom={r.nom} />
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <nav aria-label="Plan du site">
        <h2 class="font-display text-sm font-semibold tracking-[0.16em] text-white uppercase">Le site</h2>
        <ul class="mt-4 space-y-2.5">
          {
            site.nav.map((item) => (
              <li>
                <a href={withBase(item.lien)} class="transition-colors hover:text-white">
                  {item.libelle}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div>
        <h2 class="font-display text-sm font-semibold tracking-[0.16em] text-white uppercase">Contact</h2>
        <address class="mt-4 space-y-2.5 not-italic">
          {site.adresse.lignes.map((l) => <span class="block">{l}</span>)}
          <a href={`mailto:${site.email}`} class="block break-words transition-colors hover:text-white">{site.email}</a>
          <a href={`tel:${site.telephone.replace(/[^+\d]/g, '')}`} class="block transition-colors hover:text-white">
            {site.telephone}
          </a>
        </address>
      </div>
    </div>

    <div
      class="mt-12 flex flex-col gap-4 border-t border-white/10 pt-7 text-sm sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© {annee} {site.nom}. Tous droits réservés.</p>
      <ul class="flex flex-wrap gap-x-6 gap-y-2">
        <li><a href={withBase('/mentions-legales/')} class="transition-colors hover:text-white">Mentions légales</a></li>
      </ul>
    </div>
  </div>
</footer>
