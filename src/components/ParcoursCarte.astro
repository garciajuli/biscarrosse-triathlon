---
/**
 * Carte des parcours : lit les GPX de `public/uploads/parcours`, trace chaque
 * portion dans la couleur de sa discipline et calcule les distances à partir
 * des points. Le GPX est donc la seule source de vérité — remplacer le fichier
 * suffit à mettre la page à jour.
 *
 * Chaque `<trk>` du GPX porte un `<type>` : natation, velo ou course.
 *
 * Leaflet et les tuiles ne sont chargés qu'à l'approche de la section (voir
 * l'IntersectionObserver plus bas) : une page qu'on ne descend pas ne paie rien.
 * Sans JavaScript, il reste les liens de téléchargement.
 */
import 'leaflet/dist/leaflet.css';
import SectionHeader from './ui/SectionHeader.astro';
import DisciplineIcon from './ui/DisciplineIcon.astro';
import { withBase } from '../lib/content';
import type { Trace } from '../types';

interface Props {
  traces: Trace[];
  /** Phrase d'intro sous le titre de section. */
  intro?: string;
}
const { traces, intro } = Astro.props;

const parcours = traces.map((t, i) => ({ ...t, id: `parcours-${i}`, url: withBase(t.fichier) }));
const provisoire = parcours.some((p) => p.provisoire);

const legende = [
  { discipline: 'natation' as const, libelle: 'Natation' },
  { discipline: 'velo' as const, libelle: 'Vélo' },
  { discipline: 'course' as const, libelle: 'Course à pied' },
];
---

<section id="parcours" class="scroll-mt-24 bg-white py-20 sm:py-24 lg:py-28">
  <div class="shell">
    <SectionHeader
      eyebrow="Les parcours"
      titre="Reconnaître le terrain"
      intro={intro ?? 'Visualise le tracé, puis télécharge le GPX pour le charger dans ta montre ou ton compteur.'}
      class="reveal"
    />

    {
      provisoire && (
        <p class="reveal mt-8 flex items-start gap-3 rounded-card border border-sand-300 bg-sand-200/40 px-5 py-4 text-sm leading-relaxed text-navy-700">
          <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-sand-500" aria-hidden="true" />
          <span>
            <strong class="font-semibold">Tracés provisoires.</strong> Ils donnent l’esprit du parcours et l’ordre de
            grandeur des distances. Les tracés définitifs seront publiés après validation par la préfecture.
          </span>
        </p>
      )
    }

    <div
      class="reveal mt-12 overflow-hidden rounded-card border border-navy-100 bg-foam-50 shadow-soft"
      data-carte-parcours
    >
      {
        parcours.length > 1 && (
          <div class="flex flex-wrap gap-2 border-b border-navy-100 bg-white p-3" role="group" aria-label="Choisir un parcours">
            {parcours.map((p, i) => (
              <button
                type="button"
                aria-pressed={i === 0 ? 'true' : 'false'}
                data-url={p.url}
                class="rounded-full px-4 py-2 font-display text-sm font-semibold tracking-wider uppercase transition aria-pressed:bg-navy-800 aria-pressed:text-white aria-[pressed=false]:text-navy-500 aria-[pressed=false]:hover:bg-foam-100"
              >
                {p.nom}
              </button>
            ))}
          </div>
        )
      }

      <div class="relative">
        <div data-carte class="h-[22rem] w-full bg-foam-100 sm:h-[28rem] lg:h-[32rem]"></div>

        <!-- Repli tant que la carte n'est pas prête (ou si le JS échoue). -->
        <p
          data-carte-attente
          class="pointer-events-none absolute inset-0 flex items-center justify-center text-sm text-navy-400"
        >
          Chargement de la carte…
        </p>
      </div>

      <div class="flex flex-wrap items-center justify-between gap-4 border-t border-navy-100 bg-white px-5 py-4">
        <ul class="flex flex-wrap items-center gap-x-6 gap-y-2" data-legende>
          {
            legende.map((l) => (
              <li class="hidden items-center gap-2 text-sm" data-legende-item={l.discipline}>
                <span class="h-1 w-7 rounded-full" data-legende-trait />
                <DisciplineIcon discipline={l.discipline} class="h-4 w-4 text-navy-400" />
                <span class="text-navy-600">{l.libelle}</span>
                <span class="font-display font-semibold tabular-nums text-navy-900" data-legende-distance />
              </li>
            ))
          }
        </ul>

        <!-- Un seul bouton : l'onglet actif réécrit son `href`. -->
        <a
          href={parcours[0].url}
          download
          data-telechargement
          class="inline-flex items-center gap-2 rounded-full bg-ocean-400 px-5 py-2.5 font-display text-sm font-semibold tracking-wider text-navy-900 uppercase shadow-soft transition hover:bg-ocean-300 hover:shadow-lift focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ocean-400"
        >
          <svg viewBox="0 0 16 16" class="h-4 w-4" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M8 2v8M4.5 7 8 10.5 11.5 7M2.5 13h11" />
          </svg>
          Télécharger le GPX<span class="sr-only" data-telechargement-nom>&nbsp;— {parcours[0].nom}</span>
        </a>
      </div>

      {
        /* Sans JS, les onglets ne font rien : on redonne tous les fichiers. */
        parcours.length > 1 && (
          <noscript>
            <ul class="flex flex-wrap gap-x-5 gap-y-2 border-t border-navy-100 bg-white px-5 py-4 text-sm">
              {parcours.map((p) => (
                <li>
                  <a href={p.url} download class="font-semibold text-ocean-600 underline underline-offset-4">
                    GPX — {p.nom}
                  </a>
                </li>
              ))}
            </ul>
          </noscript>
        )
      }
    </div>
  </div>
</section>

<script>
  /* Leaflet n'est chargé qu'à l'approche de la section (import dynamique plus bas) :
     une page qu'on ne descend pas ne télécharge ni la bibliothèque ni les tuiles. */
  import type * as Leaflet from 'leaflet';

  let L: typeof Leaflet;

  /* Couleurs du site (cf. global.css) : une par discipline. */
  const COULEURS: Record<string, string> = {
    natation: '#3d86be', // ocean-500
    velo: '#16294b', // navy-800
    course: '#bda36c', // sand-500
  };

  const R = 6371000; // rayon terrestre moyen, en mètres
  const rad = (d: number) => (d * Math.PI) / 180;

  /** Haversine : distance en mètres entre deux points GPS. */
  function distance(a: Leaflet.LatLng, b: Leaflet.LatLng): number {
    const dLat = rad(b.lat - a.lat);
    const dLon = rad(b.lng - a.lng);
    const h =
      Math.sin(dLat / 2) ** 2 + Math.cos(rad(a.lat)) * Math.cos(rad(b.lat)) * Math.sin(dLon / 2) ** 2;
    return 2 * R * Math.asin(Math.sqrt(h));
  }

  const km = (m: number) => (m < 1000 ? `${Math.round(m / 10) * 10} m` : `${(m / 1000).toFixed(1).replace('.', ',')} km`);

  type Portion = { discipline: string; points: Leaflet.LatLng[]; longueur: number };

  /** Un `<trk>` par portion ; son `<type>` donne la discipline. */
  function lireGpx(xml: string): Portion[] {
    const doc = new DOMParser().parseFromString(xml, 'application/xml');
    if (doc.querySelector('parsererror')) throw new Error('GPX illisible');

    return [...doc.getElementsByTagName('trk')].map((trk) => {
      const points = [...trk.getElementsByTagName('trkpt')].map((pt) =>
        L.latLng(Number(pt.getAttribute('lat')), Number(pt.getAttribute('lon'))),
      );
      const longueur = points.slice(1).reduce((s, p, i) => s + distance(points[i], p), 0);
      return { discipline: trk.getElementsByTagName('type')[0]?.textContent?.trim() || 'course', points, longueur };
    });
  }

  /** Point de départ : pastille plutôt qu'épingle, pour rester sobre. */
  const depart = (p: Leaflet.LatLng) =>
    L.circleMarker(p, { radius: 7, color: '#ffffff', weight: 3, fillColor: '#16294b', fillOpacity: 1 });

  async function initialiser(bloc: HTMLElement) {
    L = (await import('leaflet')).default;

    const conteneur = bloc.querySelector<HTMLElement>('[data-carte]')!;
    const attente = bloc.querySelector<HTMLElement>('[data-carte-attente]');
    const onglets = [...bloc.querySelectorAll<HTMLButtonElement>('[data-url]')];
    const telechargement = bloc.querySelector<HTMLAnchorElement>('[data-telechargement]')!;
    const telechargementNom = bloc.querySelector<HTMLElement>('[data-telechargement-nom]');

    const carte = L.map(conteneur, { scrollWheelZoom: false, attributionControl: true });
    L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 18,
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
    }).addTo(carte);

    /* La molette ne capture la page qu'après un clic sur la carte. */
    carte.on('click', () => carte.scrollWheelZoom.enable());
    carte.on('mouseout', () => carte.scrollWheelZoom.disable());

    const couche = L.layerGroup().addTo(carte);
    const cache = new Map<string, Portion[]>();

    function majLegende(portions: Portion[]) {
      const total = new Map<string, number>();
      for (const p of portions) total.set(p.discipline, (total.get(p.discipline) ?? 0) + p.longueur);

      bloc.querySelectorAll<HTMLElement>('[data-legende-item]').forEach((item) => {
        const d = item.dataset.legendeItem!;
        const m = total.get(d);
        item.classList.toggle('hidden', !m);
        item.classList.toggle('flex', !!m);
        if (!m) return;
        item.querySelector<HTMLElement>('[data-legende-trait]')!.style.backgroundColor = COULEURS[d] ?? '#16294b';
        item.querySelector<HTMLElement>('[data-legende-distance]')!.textContent = km(m);
      });
    }

    async function afficher(url: string, nom?: string) {
      let portions = cache.get(url);
      if (!portions) {
        const reponse = await fetch(url);
        if (!reponse.ok) throw new Error(`GPX introuvable (${reponse.status})`);
        portions = lireGpx(await reponse.text());
        cache.set(url, portions);
      }

      couche.clearLayers();
      const bornes = L.latLngBounds([]);

      for (const portion of portions) {
        if (portion.points.length < 2) continue;
        const couleur = COULEURS[portion.discipline] ?? '#16294b';
        /* Liseré blanc dessous : garde le tracé lisible sur une carte chargée. */
        L.polyline(portion.points, { color: '#ffffff', weight: 7, opacity: 0.9 }).addTo(couche);
        L.polyline(portion.points, {
          color: couleur,
          weight: 4,
          opacity: 1,
          /* Natation : pointillés, comme sur les plans de course. */
          dashArray: portion.discipline === 'natation' ? '1 7' : undefined,
          lineCap: 'round',
        }).addTo(couche);
        bornes.extend(L.latLngBounds(portion.points));
      }

      if (portions[0]?.points.length) depart(portions[0].points[0]).addTo(couche);
      if (bornes.isValid()) carte.fitBounds(bornes, { padding: [28, 28] });

      majLegende(portions);
      onglets.forEach((o) => o.setAttribute('aria-pressed', String(o.dataset.url === url)));
      telechargement.href = url;
      if (telechargementNom && nom) telechargementNom.textContent = ` — ${nom}`;
    }

    const echec = (e: unknown) => {
      console.error(e);
      if (attente) attente.textContent = 'Carte indisponible — le GPX reste téléchargeable ci-dessous.';
    };

    /* `getAttribute` et non `.href` : on compare des chemins relatifs aux onglets. */
    afficher(telechargement.getAttribute('href')!)
      .then(() => attente?.remove())
      .catch(echec);

    onglets.forEach((onglet) => {
      onglet.addEventListener('click', () => {
        afficher(onglet.dataset.url!, onglet.textContent?.trim()).catch(echec);
      });
    });
  }

  /* On n'initialise qu'à l'approche de la section : Leaflet et les tuiles
     ne sont téléchargés que si la carte est vraiment regardée. */
  document.querySelectorAll<HTMLElement>('[data-carte-parcours]').forEach((bloc) => {
    const observateur = new IntersectionObserver(
      (entrees) => {
        if (!entrees.some((e) => e.isIntersecting)) return;
        observateur.disconnect();
        initialiser(bloc).catch((e) => {
          console.error(e);
          const attente = bloc.querySelector('[data-carte-attente]');
          if (attente) attente.textContent = 'Carte indisponible — le GPX reste téléchargeable ci-dessous.';
        });
      },
      { rootMargin: '300px' },
    );
    observateur.observe(bloc);
  });
</script>

<style>
  /* Leaflet pose ses propres styles ; on recale juste ce qui dépasse du thème. */
  :global(.leaflet-container) {
    font-family: inherit;
    background: var(--color-foam-100);
  }
  :global(.leaflet-control-attribution) {
    font-size: 0.68rem;
  }
</style>
