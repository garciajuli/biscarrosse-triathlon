---
/**
 * Cartes des parcours : une carte par discipline (natation, vélo, course à pied),
 * chacune avec sa distance et son GPX à télécharger. Les onglets au-dessus
 * changent de format (M, XS…) pour les trois cartes à la fois.
 *
 * Les distances sont calculées à partir des points des GPX : les fichiers sont
 * la seule source de vérité, remplacer un GPX suffit à mettre la page à jour.
 * C'est le champ du CMS où le fichier est déposé qui donne sa discipline.
 *
 * Leaflet et les tuiles ne sont chargés qu'à l'approche de la section (voir
 * l'IntersectionObserver plus bas) : une page qu'on ne descend pas ne paie rien.
 * Sans JavaScript, il reste les liens de téléchargement.
 */
import 'leaflet/dist/leaflet.css';
import SectionHeader from './ui/SectionHeader.astro';
import DisciplineIcon from './ui/DisciplineIcon.astro';
import { withBase } from '../lib/content';
import type { Discipline, Trace } from '../types';

interface Props {
  traces: Trace[];
  /** Phrase d'intro sous le titre de section. */
  intro?: string;
  /** Encart d'avertissement au-dessus des cartes ; absent ou vide = pas d'encart. */
  avertissement?: string | null;
}
const { traces, intro, avertissement } = Astro.props;

const disciplines: { discipline: Discipline; libelle: string }[] = [
  { discipline: 'natation', libelle: 'Natation' },
  { discipline: 'velo', libelle: 'Vélo' },
  { discipline: 'course', libelle: 'Course à pied' },
];

/* Par format : l'URL du GPX de chaque discipline renseignée. Un format sans
   aucun GPX n'a rien à montrer : on l'écarte. */
const parcours = traces
  .map((t) => ({
    nom: t.nom,
    fichiers: Object.fromEntries(
      disciplines.filter((d) => t[d.discipline]).map((d) => [d.discipline, withBase(t[d.discipline]!)]),
    ) as Partial<Record<Discipline, string>>,
  }))
  .filter((p) => Object.keys(p.fichiers).length > 0);

/* Une carte pour chaque discipline présente dans au moins un format. */
const cartes = disciplines.filter((d) => parcours.some((p) => p.fichiers[d.discipline]));

const texteAvertissement = avertissement?.trim();
---

{
  parcours.length > 0 && (
    <section id="parcours" class="scroll-mt-24 bg-white py-20 sm:py-24 lg:py-28">
      <div class="shell">
        <SectionHeader
          eyebrow="Les parcours"
          titre="Reconnaître le terrain"
          intro={intro ?? 'Visualise le tracé de chaque discipline, puis télécharge les GPX pour les charger dans ta montre ou ton compteur.'}
          class="reveal"
        />

        {texteAvertissement && (
          <p class="reveal mt-8 flex items-start gap-3 rounded-card border border-sand-300 bg-sand-200/40 px-5 py-4 text-sm leading-relaxed font-medium text-navy-700">
            <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-sand-500" aria-hidden="true" />
            <span>{texteAvertissement}</span>
          </p>
        )}

        <div class="reveal mt-12" data-carte-parcours data-parcours={JSON.stringify(parcours.map((p) => p.fichiers))}>
          {parcours.length > 1 && (
            <div class="mb-6 flex flex-wrap gap-2" role="group" aria-label="Choisir un format">
              {parcours.map((p, i) => (
                <button
                  type="button"
                  aria-pressed={i === 0 ? 'true' : 'false'}
                  data-onglet={i}
                  class="rounded-full px-4 py-2 font-display text-sm font-semibold tracking-wider uppercase ring-1 ring-navy-100 transition aria-pressed:bg-navy-800 aria-pressed:text-white aria-pressed:ring-navy-800 aria-[pressed=false]:text-navy-500 aria-[pressed=false]:hover:bg-foam-100"
                >
                  {p.nom}
                </button>
              ))}
            </div>
          )}

          <div class="grid gap-6 lg:grid-cols-3">
            {cartes.map((c) => {
              const url = parcours[0].fichiers[c.discipline];
              return (
                <article
                  class:list={[
                    'flex-col overflow-hidden rounded-card border border-navy-100 bg-foam-50 shadow-soft',
                    url ? 'flex' : 'hidden',
                  ]}
                  data-discipline={c.discipline}
                >
                  <header class="flex items-center justify-between gap-3 border-b border-navy-100 bg-white px-5 py-4">
                    <h3 class="flex items-center gap-2.5 text-xl text-navy-900">
                      <span class="flex h-9 w-9 items-center justify-center rounded-full bg-foam-50 text-ocean-500 ring-1 ring-navy-100">
                        <DisciplineIcon discipline={c.discipline} class="h-4.5 w-4.5" />
                      </span>
                      {c.libelle}
                    </h3>
                    <span class="font-display text-lg font-semibold tabular-nums text-navy-900" data-distance />
                  </header>

                  <div class="relative">
                    <div data-carte class="h-72 w-full bg-foam-100 sm:h-80" />
                    {/* Repli tant que la carte n'est pas prête (ou si le JS échoue). */}
                    <p
                      data-carte-attente
                      class="pointer-events-none absolute inset-0 flex items-center justify-center px-6 text-center text-sm text-navy-400"
                    >
                      Chargement de la carte…
                    </p>
                  </div>

                  <div class="border-t border-navy-100 bg-white px-5 py-4">
                    <a
                      href={url}
                      download
                      data-telechargement
                      class="inline-flex items-center gap-2 rounded-full bg-ocean-400 px-4 py-2 font-display text-sm font-semibold tracking-wider text-navy-900 uppercase shadow-soft transition hover:bg-ocean-300 hover:shadow-lift focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ocean-400"
                    >
                      <svg viewBox="0 0 16 16" class="h-4 w-4" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M8 2v8M4.5 7 8 10.5 11.5 7M2.5 13h11" />
                      </svg>
                      Télécharger le GPX
                      <span class="sr-only">&nbsp;— {c.libelle}</span>
                    </a>
                  </div>
                </article>
              );
            })}
          </div>

          {/* Sans JS, les onglets ne font rien : on redonne tous les fichiers. */}
          {parcours.length > 1 && (
            <noscript>
              <ul class="mt-6 flex flex-wrap gap-x-5 gap-y-2 text-sm">
                {parcours.flatMap((p) =>
                  disciplines
                    .filter((d) => p.fichiers[d.discipline])
                    .map((d) => (
                      <li>
                        <a href={p.fichiers[d.discipline]} download class="font-semibold text-ocean-600 underline underline-offset-4">
                          GPX {d.libelle} — {p.nom}
                        </a>
                      </li>
                    )),
                )}
              </ul>
            </noscript>
          )}
        </div>
      </div>
    </section>
  )
}

<script>
  /* Leaflet n'est chargé qu'à l'approche de la section (import dynamique plus bas) :
     une page qu'on ne descend pas ne télécharge ni la bibliothèque ni les tuiles. */
  import type * as Leaflet from 'leaflet';

  let L: typeof Leaflet;

  /* Couleurs du site (cf. global.css) : une par discipline. */
  const COULEURS: Record<string, string> = {
    natation: '#3d86be', // ocean-500
    velo: '#16294b', // navy-800
    course: '#bda36c', // sand-500
  };

  const R = 6371000; // rayon terrestre moyen, en mètres
  const rad = (d: number) => (d * Math.PI) / 180;

  /** Haversine : distance en mètres entre deux points GPS. */
  function distance(a: Leaflet.LatLng, b: Leaflet.LatLng): number {
    const dLat = rad(b.lat - a.lat);
    const dLon = rad(b.lng - a.lng);
    const h =
      Math.sin(dLat / 2) ** 2 + Math.cos(rad(a.lat)) * Math.cos(rad(b.lat)) * Math.sin(dLon / 2) ** 2;
    return 2 * R * Math.asin(Math.sqrt(h));
  }

  const km = (m: number) => (m < 1000 ? `${Math.round(m / 10) * 10} m` : `${(m / 1000).toFixed(1).replace('.', ',')} km`);

  type Portion = { points: Leaflet.LatLng[]; longueur: number };

  /** Chaque `<trk>` (ou à défaut `<rte>`) du GPX devient une portion du tracé. */
  function lireGpx(xml: string): Portion[] {
    const doc = new DOMParser().parseFromString(xml, 'application/xml');
    if (doc.querySelector('parsererror')) throw new Error('GPX illisible');

    const pistes = [...doc.getElementsByTagName('trk')];
    const blocs = pistes.length ? pistes : [...doc.getElementsByTagName('rte')];
    return blocs.map((bloc) => {
      const points = [...bloc.querySelectorAll('trkpt, rtept')].map((pt) =>
        L.latLng(Number(pt.getAttribute('lat')), Number(pt.getAttribute('lon'))),
      );
      const longueur = points.slice(1).reduce((s, p, i) => s + distance(points[i], p), 0);
      return { points, longueur };
    });
  }

  /** Point de départ : pastille plutôt qu'épingle, pour rester sobre. */
  const depart = (p: Leaflet.LatLng) =>
    L.circleMarker(p, { radius: 7, color: '#ffffff', weight: 3, fillColor: '#16294b', fillOpacity: 1 });

  const cache = new Map<string, Promise<Portion[]>>();

  function charger(url: string): Promise<Portion[]> {
    let portions = cache.get(url);
    if (!portions) {
      portions = fetch(url).then((reponse) => {
        if (!reponse.ok) throw new Error(`GPX introuvable (${reponse.status})`);
        return reponse.text().then(lireGpx);
      });
      cache.set(url, portions);
    }
    return portions;
  }

  /** Une carte Leaflet par discipline ; `afficher` y dessine le GPX demandé. */
  function creerCarte(article: HTMLElement) {
    const discipline = article.dataset.discipline!;
    const couleur = COULEURS[discipline] ?? '#16294b';
    const attente = article.querySelector<HTMLElement>('[data-carte-attente]');
    const distanceEl = article.querySelector<HTMLElement>('[data-distance]')!;
    const telechargement = article.querySelector<HTMLAnchorElement>('[data-telechargement]')!;

    const carte = L.map(article.querySelector<HTMLElement>('[data-carte]')!, { scrollWheelZoom: false });
    L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 18,
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
    }).addTo(carte);

    /* La molette ne capture la page qu'après un clic sur la carte. */
    carte.on('click', () => carte.scrollWheelZoom.enable());
    carte.on('mouseout', () => carte.scrollWheelZoom.disable());

    const couche = L.layerGroup().addTo(carte);

    return async function afficher(url: string | undefined) {
      /* Discipline absente de ce format : on masque sa carte. */
      article.classList.toggle('hidden', !url);
      article.classList.toggle('flex', !!url);
      if (!url) return;

      telechargement.href = url;
      /* La carte a pu être masquée : Leaflet doit remesurer son conteneur. */
      carte.invalidateSize();

      try {
        const portions = await charger(url);
        couche.clearLayers();
        const bornes = L.latLngBounds([]);

        for (const portion of portions) {
          if (portion.points.length < 2) continue;
          /* Liseré blanc dessous : garde le tracé lisible sur une carte chargée. */
          L.polyline(portion.points, { color: '#ffffff', weight: 7, opacity: 0.9 }).addTo(couche);
          L.polyline(portion.points, {
            color: couleur,
            weight: 4,
            opacity: 1,
            /* Natation : pointillés, comme sur les plans de course. */
            dashArray: discipline === 'natation' ? '1 7' : undefined,
            lineCap: 'round',
          }).addTo(couche);
          bornes.extend(L.latLngBounds(portion.points));
        }

        if (portions[0]?.points.length) depart(portions[0].points[0]).addTo(couche);
        if (bornes.isValid()) carte.fitBounds(bornes, { padding: [24, 24] });

        const total = portions.reduce((s, p) => s + p.longueur, 0);
        distanceEl.textContent = total ? km(total) : '';
        attente?.classList.add('hidden');
      } catch (e) {
        console.error(e);
        distanceEl.textContent = '';
        if (attente) {
          attente.textContent = 'Carte indisponible — le GPX reste téléchargeable ci-dessous.';
          attente.classList.remove('hidden');
        }
      }
    };
  }

  async function initialiser(bloc: HTMLElement) {
    L = (await import('leaflet')).default;

    const parcours: Record<string, string>[] = JSON.parse(bloc.dataset.parcours ?? '[]');
    const onglets = [...bloc.querySelectorAll<HTMLButtonElement>('[data-onglet]')];
    const cartes = [...bloc.querySelectorAll<HTMLElement>('[data-discipline]')].map((article) => ({
      discipline: article.dataset.discipline!,
      afficher: creerCarte(article),
    }));

    const afficher = (index: number) => {
      onglets.forEach((o) => o.setAttribute('aria-pressed', String(Number(o.dataset.onglet) === index)));
      return Promise.all(cartes.map((c) => c.afficher(parcours[index]?.[c.discipline])));
    };

    await afficher(0);
    onglets.forEach((onglet) => onglet.addEventListener('click', () => afficher(Number(onglet.dataset.onglet))));
  }

  /* On n'initialise qu'à l'approche de la section : Leaflet et les tuiles
     ne sont téléchargés que si les cartes sont vraiment regardées. */
  document.querySelectorAll<HTMLElement>('[data-carte-parcours]').forEach((bloc) => {
    const observateur = new IntersectionObserver(
      (entrees) => {
        if (!entrees.some((e) => e.isIntersecting)) return;
        observateur.disconnect();
        initialiser(bloc).catch((e) => {
          console.error(e);
          bloc.querySelectorAll('[data-carte-attente]').forEach((attente) => {
            attente.textContent = 'Carte indisponible — le GPX reste téléchargeable ci-dessous.';
          });
        });
      },
      { rootMargin: '300px' },
    );
    observateur.observe(bloc);
  });
</script>

<style>
  /* Leaflet pose ses propres styles ; on recale juste ce qui dépasse du thème. */
  :global(.leaflet-container) {
    font-family: inherit;
    background: var(--color-foam-100);
  }
  :global(.leaflet-control-attribution) {
    font-size: 0.68rem;
  }
</style>
