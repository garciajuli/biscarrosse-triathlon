---
import { getCollection } from 'astro:content';
import SectionHeader from './ui/SectionHeader.astro';
import DisciplineIcon from './ui/DisciplineIcon.astro';
import Button from './ui/Button.astro';
import { home } from '../lib/content';

const groupes = (await getCollection('groupes')).sort((a, b) => a.data.ordre - b.data.ordre);
const { entrainements } = home;
---

<section id="entrainements" class="scroll-mt-24 bg-foam-100 py-20 sm:py-24 lg:py-28">
  <div class="shell">
    <div class="flex flex-wrap items-end justify-between gap-8">
      <SectionHeader eyebrow={entrainements.eyebrow} titre={entrainements.titre} intro={entrainements.intro} class="reveal" />
      <Button href="#rejoindre" variante="secondaire" class="reveal mb-1">Venir essayer</Button>
    </div>

    <div class="mt-14 grid gap-6 lg:grid-cols-2">
      {
        groupes.map((groupe, i) => (
          <article
            class="reveal group flex flex-col rounded-card bg-white p-7 shadow-soft transition-shadow duration-300 hover:shadow-lift sm:p-8"
            style={`transition-delay:${i * 80}ms`}
          >
            <div class="flex items-start gap-4">
              <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-navy-800 text-ocean-300 transition-colors duration-300 group-hover:bg-ocean-400 group-hover:text-navy-900">
                <DisciplineIcon discipline={groupe.data.discipline} class="h-6 w-6" />
              </span>
              <div>
                <h3 class="text-2xl">{groupe.data.titre}</h3>
                {groupe.data.encadrant && (
                  <p class="mt-0.5 text-sm font-medium tracking-wide text-ocean-600 uppercase">{groupe.data.encadrant}</p>
                )}
              </div>
            </div>

            <p class="mt-4 leading-relaxed text-navy-500">{groupe.data.resume}</p>

            {groupe.data.creneaux.length > 0 && (
              <ul class="mt-6 divide-y divide-navy-50 border-t border-navy-50">
                {groupe.data.creneaux.map((c) => (
                  <li class="flex flex-wrap items-baseline gap-x-3 gap-y-1 py-3">
                    <span class="w-20 shrink-0 font-display font-semibold tracking-wide text-navy-900 uppercase">{c.jour}</span>
                    <span class="font-medium tabular-nums text-navy-700">{c.horaire}</span>
                    <span class="ml-auto text-right text-sm text-navy-400">
                      {c.lieu}
                      {c.groupe && <span class="block text-ocean-600">{c.groupe}</span>}
                    </span>
                  </li>
                ))}
              </ul>
            )}
          </article>
        ))
      }
    </div>

    <p class="reveal mt-10 max-w-3xl border-l-2 border-ocean-400 pl-5 text-navy-500 italic">
      {entrainements.note}
    </p>
  </div>
</section>
