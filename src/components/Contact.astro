---
import SocialIcon from './ui/SocialIcon.astro';
import Button from './ui/Button.astro';
import { site } from '../lib/content';

const telLien = `tel:${site.telephone.replace(/[^+\d]/g, '')}`;
---

<section id="contact" class="scroll-mt-24 bg-navy-900 py-20 text-white sm:py-24 lg:py-28">
  <div class="shell grid gap-14 lg:grid-cols-[0.9fr_1.1fr] lg:gap-20">
    <div class="reveal">
      <p class="eyebrow text-ocean-300">Contact</p>
      <h2 class="mt-3 text-3xl text-white sm:text-4xl">Une question&nbsp;? Écris-nous</h2>
      <span class="rule-band mt-5"></span>
      <p class="mt-5 text-lg leading-relaxed text-navy-100">
        Le bureau répond dans la semaine. Pour une première séance d'essai, précise ton âge, ton niveau et les
        disciplines qui t'intéressent — on te dirige vers le bon créneau.
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        <Button href={`mailto:${site.email}`} variante="primaire">Envoyer un mail</Button>
        <Button href={telLien} variante="fantome">Appeler le club</Button>
      </div>
    </div>

    <dl class="reveal grid gap-4 sm:grid-cols-2" style="transition-delay:120ms">
      <div class="rounded-card bg-white/6 p-6 ring-1 ring-white/10">
        <dt class="font-display text-sm font-semibold tracking-[0.16em] text-ocean-300 uppercase">Où nous trouver</dt>
        <dd class="mt-3 leading-relaxed text-navy-100">
          {site.adresse.lignes.map((l) => <span class="block">{l}</span>)}
          <a
            href={site.adresse.lien_maps}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-3 inline-block text-sm font-medium text-white underline decoration-ocean-400 decoration-2 underline-offset-4 hover:decoration-white"
          >
            Ouvrir dans une carte
          </a>
        </dd>
      </div>

      <div class="rounded-card bg-white/6 p-6 ring-1 ring-white/10">
        <dt class="font-display text-sm font-semibold tracking-[0.16em] text-ocean-300 uppercase">Nous joindre</dt>
        <dd class="mt-3 space-y-2 text-navy-100">
          <a href={`mailto:${site.email}`} class="block break-words hover:text-white">{site.email}</a>
          <a href={telLien} class="block hover:text-white">{site.telephone}</a>
        </dd>
      </div>

      <div class="rounded-card bg-white/6 p-6 ring-1 ring-white/10 sm:col-span-2">
        <dt class="font-display text-sm font-semibold tracking-[0.16em] text-ocean-300 uppercase">Nous suivre</dt>
        <dd class="mt-4 flex flex-wrap gap-3">
          {
            site.reseaux.map((r) => (
              <a
                href={r.url}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2.5 rounded-full bg-white/8 py-2.5 pr-5 pl-4 font-medium transition hover:bg-ocean-400 hover:text-navy-900"
              >
                <SocialIcon nom={r.nom} />
                {r.nom}
              </a>
            ))
          }
        </dd>
      </div>
    </dl>
  </div>
</section>
