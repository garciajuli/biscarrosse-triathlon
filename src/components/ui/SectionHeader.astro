---
interface Props {
  eyebrow: string;
  titre: string;
  intro?: string;
  sombre?: boolean;
  centre?: boolean;
  class?: string;
}
const { eyebrow, titre, intro, sombre = false, centre = false, class: className = '' } = Astro.props;
---

<header class={`${centre ? 'mx-auto max-w-2xl text-center' : 'max-w-2xl'} ${className}`}>
  <p class={`eyebrow ${sombre ? 'text-ocean-300' : ''}`}>{eyebrow}</p>
  <h2 class={`mt-3 text-3xl sm:text-4xl lg:text-[2.7rem] ${sombre ? 'text-white' : ''}`}>{titre}</h2>
  <span class={`rule-band mt-5 ${centre ? 'mx-auto' : ''}`}></span>
  {
    intro && (
      <p class={`mt-5 text-lg leading-relaxed ${sombre ? 'text-navy-100' : 'text-navy-500'}`}>{intro}</p>
    )
  }
</header>
