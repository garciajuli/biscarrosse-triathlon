---
/**
 * Ligne de pins maritimes + dunes — le motif du flanc de la trifonction.
 * Décoratif : hérite de currentColor, positions figées (build déterministe).
 */
interface Props {
  class?: string;
  retourne?: boolean;
}
const { class: className = '', retourne = false } = Astro.props;

// arrière-plan : pins plus petits et plus clairs (profondeur)
const loin = [
  { x: 60, s: 0.62 },
  { x: 168, s: 0.55 },
  { x: 300, s: 0.7 },
  { x: 428, s: 0.5 },
  { x: 560, s: 0.66 },
  { x: 690, s: 0.58 },
  { x: 812, s: 0.72 },
  { x: 950, s: 0.54 },
  { x: 1076, s: 0.64 },
  { x: 1210, s: 0.56 },
  { x: 1340, s: 0.68 },
];

// premier plan
const pres = [
  { x: 108, s: 1.28 },
  { x: 236, s: 1.02 },
  { x: 372, s: 1.5 },
  { x: 498, s: 0.94 },
  { x: 634, s: 1.34 },
  { x: 758, s: 1.1 },
  { x: 884, s: 1.44 },
  { x: 1012, s: 0.98 },
  { x: 1148, s: 1.26 },
  { x: 1288, s: 1.06 },
  { x: 1404, s: 1.18 },
];

const TRONC = 'M-3.2 0C-1.2-34-5.2-58-1.6-90L2.4-90C5-58 3-34 5.2 0Z';
---

<svg
  viewBox="0 0 1440 220"
  class={`w-full ${retourne ? 'rotate-180' : ''} ${className}`}
  preserveAspectRatio="none"
  aria-hidden="true"
  focusable="false"
  fill="currentColor"
>
  <g opacity="0.35">
    {
      loin.map((t) => (
        <g transform={`translate(${t.x} 214) scale(${t.s})`}>
          <path d={TRONC} />
          <ellipse cx="0" cy="-96" rx="26" ry="9" />
          <ellipse cx="-15" cy="-105" rx="16" ry="7" />
          <ellipse cx="16" cy="-107" rx="14" ry="6.5" />
          <ellipse cx="2" cy="-113" rx="11" ry="5.5" />
        </g>
      ))
    }
  </g>

  <g>
    {
      pres.map((t) => (
        <g transform={`translate(${t.x} 220) scale(${t.s})`}>
          <path d={TRONC} />
          <ellipse cx="0" cy="-96" rx="27" ry="9.5" />
          <ellipse cx="-16" cy="-105" rx="17" ry="7.5" />
          <ellipse cx="17" cy="-108" rx="15" ry="7" />
          <ellipse cx="1" cy="-114" rx="12" ry="6" />
        </g>
      ))
    }
  </g>

  <!-- dunes -->
  <path d="M0 196c150-22 268 14 402 10s232-30 366-22 216 34 350 26 214-24 322-30v220H0Z" opacity="0.55" />
  <path d="M0 214c186-16 300 12 470 6s268-22 430-14 296 26 540 12v202H0Z" />
</svg>
