---
/**
 * Carrousel de photos : défile automatiquement (pause au survol / focus),
 * flèches + points de navigation, swipe tactile natif. Respecte
 * prefers-reduced-motion (pas de défilement auto, saut instantané).
 * À n'utiliser qu'avec au moins 2 images (1 seule = image fixe côté appelant).
 */
import { withBase } from '../../lib/content';

interface Props {
  images: { src: string; alt?: string }[];
  class?: string;
}
const { images, class: className = '' } = Astro.props;
---

<div class={`carrousel ${className}`} data-carrousel>
  <ul class="carrousel-piste">
    {
      images.map((img, i) => (
        <li class="carrousel-slide">
          <img
            src={withBase(img.src)}
            alt={img.alt ?? ''}
            width="1200"
            height="1500"
            loading={i === 0 ? 'eager' : 'lazy'}
            decoding="async"
          />
        </li>
      ))
    }
  </ul>

  <button type="button" class="carrousel-nav carrousel-prev" aria-label="Photo précédente">
    <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
      <path d="M15 5 8 12l7 7" />
    </svg>
  </button>
  <button type="button" class="carrousel-nav carrousel-next" aria-label="Photo suivante">
    <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
      <path d="m9 5 7 7-7 7" />
    </svg>
  </button>

  <div class="carrousel-points" role="group" aria-label="Choisir une photo">
    {
      images.map((_, i) => (
        <button type="button" class="carrousel-point" data-point aria-label={`Aller à la photo ${i + 1}`} aria-current={i === 0 ? 'true' : 'false'} />
      ))
    }
  </div>
</div>

<style>
  .carrousel {
    position: relative;
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-lift);
  }
  .carrousel-piste {
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    border-radius: var(--radius-card);
    scrollbar-width: none;
  }
  .carrousel-piste::-webkit-scrollbar {
    display: none;
  }
  .carrousel-slide {
    flex: 0 0 100%;
    scroll-snap-align: center;
  }
  .carrousel-slide img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .carrousel-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 2.4rem;
    width: 2.4rem;
    border-radius: 9999px;
    background: rgb(255 255 255 / 0.85);
    color: var(--color-navy-800);
    box-shadow: var(--shadow-soft);
    backdrop-filter: blur(4px);
    transition:
      background 0.2s,
      transform 0.2s;
  }
  .carrousel-nav:hover {
    background: #fff;
  }
  .carrousel-nav svg {
    height: 1.2rem;
    width: 1.2rem;
  }
  .carrousel-prev {
    left: 0.75rem;
  }
  .carrousel-next {
    right: 0.75rem;
  }

  .carrousel-points {
    position: absolute;
    bottom: 0.85rem;
    left: 0;
    right: 0;
    display: flex;
    justify-content: center;
    gap: 0.4rem;
  }
  .carrousel-point {
    height: 0.5rem;
    width: 0.5rem;
    border-radius: 9999px;
    background: rgb(255 255 255 / 0.6);
    box-shadow: 0 1px 2px rgb(16 31 58 / 0.4);
    transition:
      width 0.25s var(--ease-out-soft),
      background 0.25s;
  }
  .carrousel-point[aria-current='true'] {
    width: 1.4rem;
    background: #fff;
  }

  @media (prefers-reduced-motion: reduce) {
    .carrousel-piste {
      scroll-behavior: auto;
    }
  }
</style>

<script>
  const AUTO_MS = 4500;
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('[data-carrousel]').forEach((car) => {
    const piste = car.querySelector<HTMLElement>('.carrousel-piste');
    const slides = Array.from(car.querySelectorAll<HTMLElement>('.carrousel-slide'));
    const points = Array.from(car.querySelectorAll<HTMLElement>('[data-point]'));
    if (!piste || slides.length < 2) return;

    let index = 0;
    let timer: ReturnType<typeof setInterval> | undefined;

    const aller = (i: number) => {
      index = (i + slides.length) % slides.length;
      piste.scrollTo({ left: index * piste.clientWidth, behavior: reduce ? 'auto' : 'smooth' });
    };

    // synchronise index + points avec le défilement réel (auto, flèches ou swipe)
    const obs = new IntersectionObserver(
      (entrees) => {
        for (const e of entrees) {
          if (!e.isIntersecting) continue;
          index = slides.indexOf(e.target as HTMLElement);
          points.forEach((p, i) => p.setAttribute('aria-current', i === index ? 'true' : 'false'));
        }
      },
      { root: piste, threshold: 0.6 },
    );
    slides.forEach((s) => obs.observe(s));

    const demarrer = () => {
      if (!reduce && !timer) timer = setInterval(() => aller(index + 1), AUTO_MS);
    };
    const arreter = () => {
      if (timer) clearInterval(timer);
      timer = undefined;
    };
    const relancer = () => {
      arreter();
      demarrer();
    };

    car.querySelector('.carrousel-prev')?.addEventListener('click', () => {
      aller(index - 1);
      relancer();
    });
    car.querySelector('.carrousel-next')?.addEventListener('click', () => {
      aller(index + 1);
      relancer();
    });
    points.forEach((p, i) =>
      p.addEventListener('click', () => {
        aller(i);
        relancer();
      }),
    );

    car.addEventListener('pointerenter', arreter);
    car.addEventListener('pointerleave', demarrer);
    car.addEventListener('focusin', arreter);
    car.addEventListener('focusout', demarrer);

    demarrer();
  });
</script>
