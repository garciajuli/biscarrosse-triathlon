---
import { getCollection } from 'astro:content';
import SectionHeader from './ui/SectionHeader.astro';
import { home, dateLongue, iso } from '../lib/content';

const articles = (await getCollection('actualites', ({ data }) => !data.brouillon))
  // les articles épinglés remontent, puis tri par date décroissante
  .sort((a, b) => {
    if (a.data.epingle !== b.data.epingle) return a.data.epingle ? -1 : 1;
    return b.data.date.getTime() - a.data.date.getTime();
  })
  .slice(0, 3);

const { actualites } = home;

const couleurs: Record<string, string> = {
  'Vie du club': 'bg-navy-800 text-white',
  Résultats: 'bg-ocean-400 text-navy-900',
  Compétition: 'bg-ocean-600 text-white',
  Entraînement: 'bg-foam-200 text-navy-800',
  Partenaires: 'bg-sand-300 text-navy-900',
};
---

<section id="actualites" class="scroll-mt-24 bg-white py-20 sm:py-24 lg:py-28">
  <div class="shell">
    <SectionHeader eyebrow={actualites.eyebrow} titre={actualites.titre} intro={actualites.intro} class="reveal" />

    <div class="mt-14 grid gap-8 md:grid-cols-3">
      {
        articles.map((article, i) => (
          <article class="reveal group flex flex-col" style={`transition-delay:${i * 90}ms`}>
            <a href={`/actualites/${article.id}/`} class="block overflow-hidden rounded-card bg-foam-100">
              {article.data.image ? (
                <img
                  src={article.data.image}
                  alt={article.data.image_alt ?? ''}
                  width="1200"
                  height="900"
                  loading="lazy"
                  decoding="async"
                  class="aspect-[4/3] w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.04]"
                />
              ) : (
                <div class="aspect-[4/3] w-full bg-foam-200"></div>
              )}
            </a>

            <div class="mt-5 flex items-center gap-3">
              <span
                class={`rounded-full px-3 py-1 font-display text-xs font-semibold tracking-wider uppercase ${couleurs[article.data.categorie] ?? 'bg-navy-800 text-white'}`}
              >
                {article.data.categorie}
              </span>
              <time class="text-sm font-medium text-navy-400" datetime={iso(article.data.date)}>
                {dateLongue(article.data.date)}
              </time>
            </div>

            <h3 class="mt-3 text-xl leading-snug lg:text-2xl">
              <a href={`/actualites/${article.id}/`} class="transition-colors hover:text-ocean-600">
                {article.data.titre}
              </a>
            </h3>

            <p class="mt-2.5 leading-relaxed text-navy-500">{article.data.resume}</p>

            <a
              href={`/actualites/${article.id}/`}
              class="mt-4 inline-flex items-center gap-1.5 self-start font-display text-sm font-semibold tracking-wider text-ocean-600 uppercase transition-colors hover:text-navy-800"
            >
              Lire la suite
              <svg
                viewBox="0 0 16 16"
                class="h-3.5 w-3.5 transition-transform duration-200 group-hover:translate-x-1"
                aria-hidden="true"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M2.5 8h10M9 4.5 12.5 8 9 11.5" />
              </svg>
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>
