---
import Button from './ui/Button.astro';
import PinesBand from './ui/PinesBand.astro';
import { home } from '../lib/content';

const { benevoles } = home;
---

{
  benevoles.actif && (
    <section class="relative overflow-hidden bg-ocean-400">
      <PinesBand class="absolute -bottom-2 left-0 h-24 text-navy-800/15 sm:h-32" />

      <div class="shell relative py-16 sm:py-20">
        <div class="flex flex-col items-start gap-8 lg:flex-row lg:items-center lg:justify-between lg:gap-16">
          <div class="reveal max-w-2xl">
            <p class="font-display text-sm font-semibold tracking-[0.18em] text-navy-700 uppercase">{benevoles.eyebrow}</p>
            <h2 class="mt-3 text-3xl text-navy-900 sm:text-4xl">{benevoles.titre}</h2>
            <p class="mt-4 text-lg leading-relaxed text-navy-800/85">{benevoles.texte}</p>
          </div>

          <Button href={benevoles.cta.lien} variante="secondaire" taille="lg" class="reveal shrink-0">
            {benevoles.cta.libelle}
          </Button>
        </div>
      </div>
    </section>
  )
}
